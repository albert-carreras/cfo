# The brain's only secret. No third-party tokens in the manual-entry core.
# Local dev (docker compose up -d) matches this:
DATABASE_URL=postgresql://cfo:cfo@localhost:5433/cfo
# Optional push notifications (ntfy). Status transitions, material changes,
# feed failures and completed checks; coarse payloads only — never € amounts.
# NTFY_URL=https://ntfy.sh/your-topic
# Optional monthly qualitative CFO check. Absent means the deterministic
# verdict and every record/calculation/export surface still work.
# OPENAI_API_KEY=sk-...
# Optional provider-model override. Absent uses src/ai/check.ts's default.
# OPENAI_MODEL=gpt-5.6-sol
