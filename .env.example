# The brain's only secret. No third-party tokens in the manual-entry core.
# Local dev (docker compose up -d) matches this:
DATABASE_URL=postgresql://cfo:cfo@localhost:5433/cfo
# Optional push notifications (ntfy). Status transitions, material changes,
# feed failures and published reviews; coarse payloads only — never € amounts.
# NTFY_URL=https://ntfy.sh/your-topic
# The voice's key — the one egress. Absent ⇒ every AI surface degrades to its
# deterministic floor.
# OPENAI_API_KEY=sk-...
# Provider model override for every voice surface. Absent ⇒ the versioned
# default in src/ai/openai.ts (the current flagship tier).
# OPENAI_MODEL=gpt-5.6
