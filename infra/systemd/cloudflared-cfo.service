[Unit]
Description=Cloudflare Tunnel for cfo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --protocol quic run --token-file /etc/cloudflared/cfo.token
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
